<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="window_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- One wall with one centered window opening -->
    <!-- Units are meters -->
    <!-- height = 113 in = 2.8702 -->
    <!-- window width = 87 in = 2.2098 -->
    <!-- window height = 57 in = 1.4478 -->
    <!-- assumed wall length = 4.2098 -->
    <!-- assumed wall thickness = 0.10 -->
    <model name="wall_one_window">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>

      <link name="wall_link">

        <!-- bottom -->
        <collision name="bottom_collision">
          <pose>0 0 0.3556 0 0 0</pose>
          <geometry>
            <box>
              <size>4.2098 0.10 0.7112</size>
            </box>
          </geometry>
        </collision>
        <visual name="bottom_visual">
          <pose>0 0 0.3556 0 0 0</pose>
          <geometry>
            <box>
              <size>4.2098 0.10 0.7112</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>

        <!-- top -->
        <collision name="top_collision">
          <pose>0 0 2.5146 0 0 0</pose>
          <geometry>
            <box>
              <size>4.2098 0.10 0.7112</size>
            </box>
          </geometry>
        </collision>
        <visual name="top_visual">
          <pose>0 0 2.5146 0 0 0</pose>
          <geometry>
            <box>
              <size>4.2098 0.10 0.7112</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>

        <!-- left side -->
        <collision name="left_collision">
          <pose>-1.6049 0 1.4351 0 0 0</pose>
          <geometry>
            <box>
              <size>1.0000 0.10 1.4478</size>
            </box>
          </geometry>
        </collision>
        <visual name="left_visual">
          <pose>-1.6049 0 1.4351 0 0 0</pose>
          <geometry>
            <box>
              <size>1.0000 0.10 1.4478</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>

        <!-- right side -->
        <collision name="right_collision">
          <pose>1.6049 0 1.4351 0 0 0</pose>
          <geometry>
            <box>
              <size>1.0000 0.10 1.4478</size>
            </box>
          </geometry>
        </collision>
        <visual name="right_visual">
          <pose>1.6049 0 1.4351 0 0 0</pose>
          <geometry>
            <box>
              <size>1.0000 0.10 1.4478</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

  </world>
</sdf>