FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_NO_CACHE_DIR=1
ENV PIP_DEFAULT_TIMEOUT=120

# Install Gazebo Harmonic and base dependencies
RUN apt-get update && apt-get install -y \
    curl gnupg lsb-release \
    python3 python3-pip python3-numpy python3-opencv \
    libgl1 git nano \
    && curl -sSL http://packages.osrfoundation.org/gazebo.gpg | apt-key add - \
    && echo "deb http://packages.osrfoundation.org/gazebo/ubuntu-stable $(lsb_release -cs) main" > /etc/apt/sources.list.d/gazebo-stable.list \
    && apt-get update \
    && apt-get install -y gz-harmonic python3-gz-transport13 \
    && rm -rf /var/lib/apt/lists/*

# Environment
ENV DISPLAY=:0

COPY Projects/socket_demo/client/requirements.txt /tmp/req_socket.txt
COPY Projects/ub_racer/client/requirements.txt /tmp/req_racer.txt
RUN python3 -m pip install --break-system-packages --retries 10 --timeout 120 \
    -r /tmp/req_socket.txt \
    -r /tmp/req_racer.txt

WORKDIR /workspace

# ub_camera pre-reqs and ub_code
# numpy/ultralytics first, then swap opencv packages, then remaining deps
RUN python3 -m pip install --break-system-packages --ignore-installed --retries 10 --timeout 120 \
        "numpy>=1.21.0" \
        "ultralytics>=8.3.0" \
    && python3 -m pip uninstall --break-system-packages -y opencv-python opencv-contrib-python \
    && python3 -m pip install --break-system-packages --retries 10 --timeout 120 \
        "opencv-contrib-python>=4.10.0" \
        "pyzbar>=0.1.9" \
        "websockets>=12.0" \
        "aiortc>=1.9.0" \
        "aiohttp>=3.9.0" \
        git+https://github.com/optimatorlab/ub_code.git@main

COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
